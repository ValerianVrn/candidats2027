---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { activeCandidates, candidates, changelog, fullName, site } from '../lib/data';
import { formatDateTime, formatDay, formatShortDay } from '../lib/dates';
import { REPORT_ERROR_URL } from '../lib/site';
import { DONATION_URL } from '../lib/donations';

const nameBySlug = new Map(candidates.map((c) => [c.slug, fullName(c)]));
const lastChange = changelog[0]?.date ?? null;
const changeDays = new Set(changelog.map((e) => e.date));
/** Runs that reviewed every profile and found nothing to change. */
const quietDays = site.checks
  .filter((c) => c.reviewed >= activeCandidates.length && !changeDays.has(c.date))
  .map((c) => c.date)
  .toSorted((a, b) => b.localeCompare(a));
---

<Base support title="Journal des mises à jour" section="journal" ads>
  <div class="page">
    <h1>Journal des mises à jour</h1>
    <!-- prettier-ignore -->
    <p class="lead">
      Chaque jour, les informations du site sont vérifiées et mises à jour à partir de sources publiques.
      Voici ce qui a changé, et pourquoi. Une erreur ? <a href={REPORT_ERROR_URL} target="_blank" rel="noopener">Signalez-la</a>.
    </p>
    <!-- prettier-ignore -->
    <p class="lead">Pour les événements de la campagne (déclarations, retraits, débats, meetings) à leur date, voir le <a href="/calendrier">calendrier</a>.</p>
    <p class="status">
      Dernière vérification : {formatDateTime(site.lastChecked)}.
      {lastChange && ` Dernier changement : ${formatDay(lastChange)}.`}
    </p>
    {quietDays.length > 0 && (
      <p class="quiet">Vérifié sans changement : {quietDays.map((d) => formatShortDay(d)).join(', ')}.</p>
    )}
    <AdSlot placement="journal" />
    <ol class="entries">
      {changelog.map((e) => (
        <li class="entry">
          <h2>
            <time datetime={e.date}>{formatDay(e.date)}</time>
          </h2>
          <p>{e.summary}</p>
          {e.changes.length > 0 && (
            <ul>
              {e.changes.map((ch) => (
                <li>
                  {ch.candidate && nameBySlug.has(ch.candidate) && (
                    <a href={`/candidat/${ch.candidate}`}>{nameBySlug.get(ch.candidate)}</a>
                  )}
                  {ch.candidate && nameBySlug.has(ch.candidate) && ' : '}
                  {ch.text}
                </li>
              ))}
            </ul>
          )}
          {e.sources.length > 0 && (
            <p class="src">
              Sources :{' '}
              {e.sources.map((s, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={s.url} target="_blank" rel="noopener">
                    {s.outlet}
                  </a>
                </>
              ))}
            </p>
          )}
        </li>
      ))}
    </ol>
    {DONATION_URL && (
      <p class="support">
        Ce suivi quotidien est financé par la publicité et par les lecteurs.{' '}
        <a href="/financement#soutenir">Soutenir le site</a>
      </p>
    )}
  </div>
</Base>

<style>
  .lead {
    color: var(--muted);
  }
  .support {
    margin-top: 24px;
    font-size: 14px;
    color: var(--muted);
  }
  .status {
    margin: 16px 0 0;
    padding: 10px 14px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 14px;
  }
  .quiet {
    margin: 8px 0 0;
    font-size: 13px;
    color: var(--muted);
  }
  .entries {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .entry {
    padding: 18px 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .entry h2 {
    margin: 0 0 6px;
    font-size: 18px;
  }
  .entry p {
    margin: 0 0 8px;
  }
  .entry ul {
    margin: 0 0 8px;
    padding-left: 20px;
  }
  .src {
    font-size: 13px;
    color: var(--muted);
  }
</style>
