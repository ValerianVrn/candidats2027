---
import Base from '../../layouts/Base.astro';
import CandidateDetail from '../../components/CandidateDetail.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { candidates, fullName, partyOf } from '../../lib/data';
import { breadcrumbLd, personLd } from '../../lib/seo';
import type { Candidate } from '../../lib/schemas';

export function getStaticPaths() {
  return candidates.map((candidate) => ({ params: { slug: candidate.slug }, props: { candidate } }));
}

interface Props {
  candidate: Candidate;
}
const { candidate } = Astro.props;
const party = partyOf(candidate);
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/portraits/*.{jpg,jpeg,png,webp}',
  {
    eager: true,
  },
);
const portrait = candidate.portrait
  ? portraits[`../../assets/portraits/${candidate.portrait.file}`]?.default
  : undefined;
const image = portrait ? (await getImage({ src: portrait, width: 600, format: 'webp' })).src : null;
const site = Astro.site!;
const jsonLd = [
  personLd(site, {
    givenName: candidate.firstName,
    familyName: candidate.lastName,
    path: `/candidat/${candidate.slug}`,
    jobTitle: candidate.role,
    party: party?.name ?? null,
    image,
  }),
  breadcrumbLd(site, [
    { name: 'Candidats 2027', path: '/' },
    { name: 'Liste des candidats', path: '/candidats' },
    { name: fullName(candidate), path: `/candidat/${candidate.slug}` },
  ]),
];
const role =
  candidate.status === 'potentiel'
    ? "candidature évoquée à l'élection présidentielle 2027"
    : `${candidate.genre === 'f' ? 'candidate' : 'candidat'} à l'élection présidentielle 2027`;
const description = `${fullName(candidate)}${party ? ` (${party.name})` : ''}, ${role} : programme, agenda, débats, déclaration et procédures en cours, avec sources.`;
---

<Base
  title={`${fullName(candidate)} 2027 : programme, agenda et procédures`}
  description={description}
  section="candidats"
  jsonLd={jsonLd}
>
  <div class="page">
    <p class="back">
      <a href={`/#${candidate.slug}`}>← Tous les candidats</a>
    </p>
    <div class="card">
      <CandidateDetail candidate={candidate} mode="page" />
    </div>
  </div>
</Base>

<style>
  .back {
    margin: 0 0 16px;
    font-size: 14px;
  }
  .card {
    padding: clamp(18px, 3vw, 32px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
</style>
