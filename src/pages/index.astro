---
import Base from '../layouts/Base.astro';
import CardCloud from '../components/CardCloud.astro';
import CandidateDetail from '../components/CandidateDetail.astro';
import QuizLens from '../components/QuizLens.astro';
import OtherCandidates from '../components/OtherCandidates.astro';
import AdSlot from '../components/AdSlot.astro';
import DebateStrip from '../components/DebateStrip.astro';
import { activeCandidates, featuredCandidates, otherCandidates } from '../lib/data';
---

<Base section="candidats" ads>
  <h1 class="visually-hidden">Les candidats à l'élection présidentielle de 2027</h1>
  <QuizLens />
  <DebateStrip />
  <CardCloud candidates={featuredCandidates} everyone={activeCandidates} />
  <OtherCandidates candidates={otherCandidates} />

  <AdSlot placement="home" />

  <!-- Candidate details: a wide drawer (native modal dialog: focus trap, Escape, backdrop, inert page). -->
  <dialog class="drawer" aria-label="Détail du candidat" data-drawer>
    <button type="button" class="close" data-close aria-label="Fermer le détail">
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
    {activeCandidates.map((c) => (
      <div class="wrap" data-detail-wrap={c.slug} hidden>
        <CandidateDetail candidate={c} mode="panel" />
      </div>
    ))}
  </dialog>
</Base>

<script>
  const drawer = document.querySelector<HTMLDialogElement>('[data-drawer]')!;
  let lastCard: HTMLElement | null = null;

  function open(slug: string, fromCard?: HTMLElement) {
    const wrap = drawer.querySelector<HTMLElement>(`[data-detail-wrap="${CSS.escape(slug)}"]`);
    if (!wrap) return;
    drawer.querySelectorAll<HTMLElement>('[data-detail-wrap]').forEach((w) => (w.hidden = w !== wrap));
    // Always start on the first tab, scrolled to the top.
    const firstTab = wrap.querySelector<HTMLButtonElement>('[role="tab"]');
    if (firstTab) selectTab(firstTab);
    wrap.querySelector<HTMLElement>('.body')?.scrollTo({ top: 0 });

    document.querySelectorAll('.card[aria-current]').forEach((a) => a.removeAttribute('aria-current'));
    const card = fromCard ?? document.querySelector<HTMLElement>(`.card[data-slug="${CSS.escape(slug)}"]`);
    card?.setAttribute('aria-current', 'true');
    lastCard = card ?? null;
    history.replaceState(null, '', `#${slug}`);
    if (!drawer.open) drawer.showModal();
    wrap.querySelector<HTMLElement>('h2')?.focus();
  }

  drawer.addEventListener('close', () => {
    document.querySelectorAll('.card[aria-current]').forEach((a) => a.removeAttribute('aria-current'));
    history.replaceState(null, '', location.pathname + location.search);
    lastCard?.focus();
  });

  drawer.querySelectorAll<HTMLElement>('[data-detail-wrap] h2').forEach((h) => (h.tabIndex = -1));

  // A click on the backdrop (outside the drawer box) closes it.
  drawer.addEventListener('click', (e) => {
    if (e.target === drawer) drawer.close();
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    const card = target.closest<HTMLAnchorElement>('.card[data-slug]');
    if (card && !(e as MouseEvent).ctrlKey && !(e as MouseEvent).metaKey) {
      e.preventDefault();
      open(card.dataset.slug!, card);
      return;
    }
    if (target.closest('[data-close]')) drawer.close();
    const tab = target.closest<HTMLButtonElement>('[role="tab"]');
    if (tab) selectTab(tab);
  });

  function selectTab(tab: HTMLButtonElement) {
    const list = tab.closest('[role="tablist"]')!;
    list.querySelectorAll<HTMLButtonElement>('[role="tab"]').forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    });
    tab.closest('.wrap')?.querySelector<HTMLElement>('.body')?.scrollTo({ top: 0 });
  }

  document.addEventListener('keydown', (e) => {
    const tab = (e.target as Element).closest?.<HTMLButtonElement>('[role="tab"]');
    if (tab && (e.key === 'ArrowRight' || e.key === 'ArrowLeft')) {
      const tabs = [...tab.closest('[role="tablist"]')!.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const next = tabs[(tabs.indexOf(tab) + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length]!;
      selectTab(next);
      next.focus();
    }
  });

  function openFromHash() {
    const slug = decodeURIComponent(location.hash.slice(1));
    if (slug && !slug.includes('=')) open(slug);
  }
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
</script>

<style>
  :global(.cloud),
  :global(.others) {
    padding-left: var(--gutter);
    padding-right: var(--gutter);
  }
  :global(html:has(dialog[open])) {
    overflow: hidden;
  }

  .drawer {
    position: fixed;
    inset: 0 0 0 auto;
    margin: 0;
    width: min(560px, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    box-shadow: -24px 0 60px rgba(0, 0, 0, 0.45);
  }
  .drawer[open] {
    animation: slide-in 0.28s ease-out;
  }
  .drawer::backdrop {
    background: rgba(5, 8, 20, 0.6);
    backdrop-filter: blur(2px);
  }
  @keyframes slide-in {
    from {
      transform: translateX(100%);
    }
    to {
      transform: none;
    }
  }
  .wrap {
    height: 100%;
  }
  .wrap[hidden] {
    display: none;
  }
  .close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface-2);
    cursor: pointer;
  }
  .close:hover {
    background: var(--raised);
  }
</style>
