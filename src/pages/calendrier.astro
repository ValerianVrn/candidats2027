---
/**
 * « Calendrier »: what is coming (rounds, key dates, announced debates and meetings) and the campaign chronology
 * (declarations, withdrawals, debates, meetings), every dated fact the data holds, each with its sources.
 * Rebuilt every day by the routine, so « à venir » / « ce qui s'est passé » stay true. Every item is in the HTML;
 * the filter chips only hide items client-side.
 */
import Base from '../layouts/Base.astro';
import Cite from '../components/Cite.astro';
import { candidates, election, events, fullName } from '../lib/data';
import { CitationRegistry } from '../lib/citations';
import { formatDay, formatDeclarationDate, parisDateTime } from '../lib/dates';
import { parisDay } from '../lib/freshness';
import { buildChronology, byMonth, CHRONO_GROUP, type ChronoItem } from '../lib/chronology';
import { breadcrumbLd, eventLd, type JsonLd } from '../lib/seo';

const site = Astro.site!;
const today = parisDay(new Date().toISOString());
const bySlug = new Map(candidates.map((c) => [c.slug, c]));
const person = (slug: string) => {
  const c = bySlug.get(slug);
  return c ? { name: fullName(c), path: `/candidat/${c.slug}` } : null;
};
const eventById = new Map(events.map((e) => [e.id, e]));
const { upcoming, past } = buildChronology(candidates, events, election, today);
const months = byMonth(past);
const firstDay = election.firstRound.slice(0, 10);
const secondDay = election.secondRound.slice(0, 10);
const reg = new CitationRegistry();
const id = 'cal';

const KIND_LABEL: Record<ChronoItem['kind'], string> = {
  declaration: 'Candidature',
  retrait: 'Retrait',
  debat: 'Débat',
  emission: 'Émission',
  meeting: 'Meeting',
  scrutin: 'Scrutin',
  etape: 'Étape',
};
const FILTERS = [
  { id: 'tout', label: 'Tout' },
  { id: 'candidatures', label: 'Candidatures' },
  { id: 'debats', label: 'Débats' },
  { id: 'meetings', label: 'Meetings' },
] as const;
const when = (i: ChronoItem) =>
  i.precision === 'day'
    ? `${formatDay(i.date)}${i.time ? ` à ${i.time.replace(':', ' h ')}` : ''}`
    : formatDeclarationDate(i.date, i.precision);

const debates = events.filter((e) => e.kind === 'debat');
const jsonLd: JsonLd[] = [
  eventLd(site, {
    name: 'Premier tour de l’élection présidentielle 2027',
    startDate: election.firstRound,
    description: 'Premier tour de scrutin de l’élection présidentielle française.',
    path: '/calendrier',
    place: 'France',
    broadcast: false,
    performers: [],
  }),
  eventLd(site, {
    name: 'Second tour de l’élection présidentielle 2027',
    startDate: election.secondRound,
    description: 'Second tour de scrutin de l’élection présidentielle française.',
    path: '/calendrier',
    place: 'France',
    broadcast: false,
    performers: [],
  }),
  ...debates.map((e) =>
    eventLd(site, {
      name: e.title,
      startDate: parisDateTime(e.date, e.time),
      description: e.summary,
      path: '/calendrier',
      place: e.channels.join(', '),
      broadcast: true,
      performers: e.participants.map(person).filter((p) => p !== null),
    }),
  ),
  breadcrumbLd(site, [
    { name: 'Accueil', path: '/' },
    { name: 'Calendrier', path: '/calendrier' },
  ]),
];
---

<Base
  title="Présidentielle 2027 : calendrier et chronologie de la campagne"
  description={`Élection présidentielle 2027 : premier tour le ${formatDay(firstDay)}, second tour le ${formatDay(secondDay)}. Dates clés, débats télévisés, meetings, déclarations et retraits de candidature, avec sources.`}
  section="calendrier"
  jsonLd={jsonLd}
>
  <article class="page">
    <nav class="crumbs" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a> › Calendrier
    </nav>
    <h1>Présidentielle 2027 : calendrier et chronologie</h1>
    <p class="lead">
      Premier tour le {formatDay(firstDay)}, second tour le {formatDay(secondDay)}.
    </p>

    <div class="filters" role="group" aria-label="Filtrer" data-filters hidden>
      {FILTERS.map((f, i) => (
        <button type="button" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f.label}
        </button>
      ))}
    </div>

    {[
      {
        title: 'À venir',
        groups: [{ month: null as string | null, items: upcoming }],
        empty: 'Rien d’annoncé.',
      },
      { title: 'Ce qui s’est passé', groups: months, empty: 'Rien pour le moment.' },
    ].map((section) => (
      <section class="block">
        <h2>{section.title}</h2>
        {section.groups.every((g) => g.items.length === 0) && <p class="empty">{section.empty}</p>}
        {section.groups.map((g) => (
          <>
            {g.month && <h3 class="month">{g.month}</h3>}
            <ol class="items">
              {g.items.map((item) => {
                const ev = eventById.get(item.id);
                const people = item.slugs.map(person).filter((p) => p !== null);
                const linkNames = item.kind === 'debat' || item.kind === 'emission';
                return (
                  <li data-group={CHRONO_GROUP[item.kind]} data-kind={item.kind}>
                    <p class="when">
                      <span class="kind">{KIND_LABEL[item.kind]}</span>
                      <time datetime={item.date}>{when(item)}</time>
                    </p>
                    <p class="what">
                      {!linkNames && people.length === 1 ? (
                        <a href={people[0]!.path}>{item.text}</a>
                      ) : (
                        item.text
                      )}
                      <Cite numbers={reg.cite(item.sources)} idPrefix={id} />
                    </p>
                    {ev && <p class="detail">{ev.summary}</p>}
                    {linkNames && people.length > 0 && (
                      <p class="detail">
                        Avec{' '}
                        {people.map((p, i) => (
                          <>
                            <a href={p.path}>{p.name}</a>
                            {i < people.length - 1 ? ', ' : '.'}
                          </>
                        ))}
                      </p>
                    )}
                    {ev && ev.absents.length > 0 && (
                      <p class="detail">
                        Absents :{' '}
                        {ev.absents.map((a, i) => {
                          const p = person(a.slug);
                          return (
                            <>
                              {p ? <a href={p.path}>{p.name}</a> : a.slug} ({a.note.replace(/\.$/, '')})
                              {i < ev.absents.length - 1 ? ' ; ' : '.'}
                            </>
                          );
                        })}
                      </p>
                    )}
                  </li>
                );
              })}
            </ol>
          </>
        ))}
      </section>
    ))}

    <section class="sources">
      <h2>Sources</h2>
      <ol>
        {reg.list.map((s, i) => (
          <li id={`${id}-src-${i + 1}`}>
            <a href={s.url} target="_blank" rel="noopener">
              {s.outlet}
              {s.title ? ` : ${s.title}` : ''}
            </a>{' '}
            <span>({formatDay(s.date)})</span>
          </li>
        ))}
      </ol>
    </section>
  </article>
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  if (bar) {
    bar.hidden = false;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('button')];
    const items = [...document.querySelectorAll<HTMLElement>('[data-group]')];
    const months = [...document.querySelectorAll<HTMLElement>('.month')];
    bar.addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement).closest('button');
      if (!btn) return;
      const f = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      items.forEach((li) => {
        li.hidden = f !== 'tout' && li.dataset.group !== f;
      });
      // Hide month headings whose list became empty.
      months.forEach((h) => {
        const list = h.nextElementSibling;
        h.hidden = !!list && [...list.children].every((c) => (c as HTMLElement).hidden);
      });
    });
  }
</script>

<style>
  .crumbs {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .lead {
    font-size: 18px;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 16px 0 4px;
  }
  .filters[hidden],
  [hidden] {
    display: none !important;
  }
  .filters button {
    font: inherit;
    font-size: 14px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .filters button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  h2 {
    font-size: 22px;
    margin: 28px 0 6px;
  }
  .month {
    font-size: 15px;
    text-transform: capitalize;
    color: var(--accent);
    margin: 18px 0 4px;
  }
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .items li {
    padding: 10px 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .items p {
    margin: 2px 0;
  }
  .when {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: 13px;
    color: var(--muted);
  }
  .kind {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
    min-width: 86px;
  }
  .items li[data-kind='retrait'] .kind {
    color: var(--warn-text);
  }
  .items li[data-kind='scrutin'] .what {
    font-weight: 700;
    color: var(--ink-strong);
  }
  .what a {
    text-decoration: none;
  }
  .what a:hover {
    text-decoration: underline;
  }
  .detail {
    font-size: 14px;
    color: var(--muted);
  }
  .empty {
    color: var(--muted);
  }
  .sources ol {
    font-size: 13px;
    color: var(--muted);
    padding-left: 22px;
  }
</style>
