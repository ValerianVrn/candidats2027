---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Candidate } from '../lib/schemas';

interface Props {
  candidate: Candidate;
  size: number;
  /** Eager-load images above the fold. */
  eager?: boolean;
}
const { candidate, size, eager = false } = Astro.props;

const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/portraits/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const img = candidate.portrait
  ? portraits[`../assets/portraits/${candidate.portrait.file}`]?.default
  : undefined;
if (candidate.portrait && !img) {
  throw new Error(`Missing portrait file src/assets/portraits/${candidate.portrait.file}`);
}
const initials = `${candidate.firstName[0] ?? ''}${candidate.lastName[0] ?? ''}`.toUpperCase();
---

<span class="avatar" style={`--size:${size}px`}>
  {img ? (
    <Image
      src={img}
      alt=""
      width={size * 2}
      height={size * 2}
      loading={eager ? 'eager' : 'lazy'}
      fit="cover"
      position="top"
    />
  ) : (
    <span class="initials" aria-hidden="true">
      {initials}
    </span>
  )}
</span>

<style>
  .avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    overflow: hidden;
    background: linear-gradient(160deg, #2b3a73, #18224a);
    flex: 0 0 auto;
  }
  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .initials {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(var(--size) * 0.32);
    color: var(--ink);
  }
</style>
