---
import { election, verified } from '../lib/data';
import { countdown, formatDateTime, formatDay, formatShortDay, relativeAgo } from '../lib/dates';

interface Props {
  section: 'candidats' | 'quiz' | 'journal' | null;
}
const { section } = Astro.props;

const now = new Date();
const target = new Date(election.firstRound);
const cd = countdown(target, now);
const firstRoundDay = formatDay(election.firstRound.slice(0, 10));
const links = [
  { id: 'candidats', href: '/', label: 'Candidats' },
  { id: 'quiz', href: '/quiz', label: 'Quiz' },
  { id: 'journal', href: '/journal', label: 'Journal' },
] as const;
---

<header class="top">
  <a class="brand" href="/" aria-label="Candidats 2027, accueil">
    <span class="flag" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
    <span class="brand-name">Candidats 2027</span>
  </a>

  <nav aria-label="Sections" class="nav">
    {links.map((l) => (
      <a href={l.href} aria-current={section === l.id ? 'page' : undefined}>
        {l.label}
      </a>
    ))}
  </nav>

  <div class="status">
    <p class="countdown" data-countdown={election.firstRound} title={`Premier tour le ${firstRoundDay}`}>
      <span class="countdown-days" data-days>
        {cd.done ? 'Jour J' : `J‑${cd.days}`}
      </span>
      <span class="countdown-label">
        <span>
          avant le 1<sup>er</sup> tour
        </span>
        <span data-hm>{firstRoundDay}</span>
      </span>
    </p>
    <p class="updated">
      <span class="dot" aria-hidden="true"></span>
      {verified.at ? (
        <time
          datetime={verified.at}
          data-ago
          title={`Toutes les fiches vérifiées le ${formatDateTime(verified.at)}`}
        >
          Vérifié {relativeAgo(new Date(verified.at), now)}
        </time>
      ) : (
        <time
          datetime={verified.day}
          title={`Toutes les fiches ont été vérifiées au moins depuis le ${formatDay(verified.day)}`}
        >
          Vérifié le {formatShortDay(verified.day)}
        </time>
      )}
    </p>
  </div>
</header>

<script>
  import { countdown, relativeAgo } from '../lib/dates';

  function tick() {
    const now = new Date();
    const el = document.querySelector<HTMLElement>('[data-countdown]');
    if (el) {
      const cd = countdown(new Date(el.dataset.countdown!), now);
      el.querySelector('[data-days]')!.textContent = cd.done ? 'Jour J' : `J‑${cd.days}`;
      const hm = el.querySelector('[data-hm]');
      if (hm && !cd.done) hm.textContent = `${cd.hours} h ${String(cd.minutes).padStart(2, '0')} min`;
    }
    const ago = document.querySelector<HTMLTimeElement>('[data-ago]');
    if (ago) ago.textContent = `Vérifié ${relativeAgo(new Date(ago.dateTime), now)}`;
  }
  tick();
  setInterval(tick, 30_000);
</script>

<style>
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    padding: 14px var(--gutter);
    border-bottom: 1px solid var(--line-soft);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    text-decoration: none;
  }
  .flag {
    display: flex;
    width: 28px;
    height: 20px;
    border-radius: 3px;
    overflow: hidden;
  }
  .flag span {
    flex: 1;
  }
  .flag span:nth-child(1) {
    background: #3d6bff;
  }
  .flag span:nth-child(2) {
    background: #f4f6fb;
  }
  .flag span:nth-child(3) {
    background: #ff4d5e;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
  }
  .nav {
    display: flex;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: var(--surface);
  }
  .nav a {
    padding: 9px 18px;
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
  }
  .nav a[aria-current='page'] {
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
  }
  .status {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .status p {
    margin: 0;
  }
  .countdown {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .countdown-days {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 700;
    color: var(--ink-strong);
    white-space: nowrap;
    line-height: 1;
  }
  .countdown-label {
    display: flex;
    flex-direction: column;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.3;
  }
  .countdown-label sup {
    line-height: 0;
  }
  .updated {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--muted);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4fd18b;
  }
  @media (max-width: 720px) {
    .top {
      justify-content: center;
    }
    .nav {
      order: 3;
      width: 100%;
      justify-content: center;
    }
  }
</style>
