---
/**
 * Home page « Dernièrement »: the three latest dated facts of the campaign chronology (declarations, withdrawals,
 * debates, meetings), with a link to the full chronology on /calendrier.
 */
import { candidates, election, events } from '../lib/data';
import { formatDay, formatDeclarationDate } from '../lib/dates';
import { parisDay } from '../lib/freshness';
import { buildChronology } from '../lib/chronology';

const today = parisDay(new Date().toISOString());
const latest = buildChronology(candidates, events, election, today)
  .past.filter((i) => i.precision !== 'before')
  .slice(0, 3);
---

{latest.length > 0 && (
  <section class="latest" aria-labelledby="latest-title">
    <h2 id="latest-title">Dernièrement</h2>
    <ul>
      {latest.map((i) => (
        <li>
          <time datetime={i.date}>
            {i.precision === 'day' ? formatDay(i.date) : formatDeclarationDate(i.date, i.precision)}
          </time>
          {i.slugs.length === 1 ? <a href={`/candidat/${i.slugs[0]}`}>{i.text}</a> : <span>{i.text}</span>}
        </li>
      ))}
    </ul>
    <a class="all" href="/calendrier">
      Toute la chronologie →
    </a>
  </section>
)}

<style>
  .latest {
    margin: 12px var(--gutter) 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
    font-size: 14px;
  }
  h2 {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  li {
    display: flex;
    gap: 6px;
    align-items: baseline;
  }
  time {
    color: var(--muted);
    font-size: 13px;
    white-space: nowrap;
  }
  li a {
    color: var(--ink);
    text-decoration: none;
  }
  li a:hover {
    text-decoration: underline;
  }
  .all {
    font-size: 13px;
  }
</style>
